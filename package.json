{
  "name": "definit",
  "version": "1.0.0",
  "private": true,
  "description": "DEFINIT -- finality-gated autonomous execution on GenLayer",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:direct": "node scripts/run-python.mjs tests/direct",
    "test:attacks": "node scripts/run-python.mjs tests/attacks",
    "test:lifecycle": "node scripts/run-python.mjs tests/lifecycle",
    "test:integration": "node scripts/run-python.mjs tests/integration --integration",
    "test:unit": "vitest run tests/unit",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run test:direct && npm run test:attacks && npm run test:lifecycle && npm run check:no-clock",
    "proof": "npm run test:attacks && node scripts/proof.mjs",
    "evidence": "node scripts/evidence.mjs",
    "probe:final-scope": "node scripts/probe-final-scope.mjs",
    "contracts:check": "node scripts/validate-contracts.mjs",
    "lint:contracts": "node scripts/lint-contracts.mjs",
    "audit:isolation": "node scripts/audit-isolation.mjs",
    "docs:check": "node scripts/docs-check.mjs",
    "verify:submission": "node scripts/verify-submission.mjs",
    "research:matrix": "node scripts/research-matrix.mjs",
    "test:commitments": "vitest run tests/unit/commitment.test.ts",
    "deploy": "node scripts/deploy.mjs",
    "deploy:dry": "node scripts/deploy.mjs --dry-run",
    "lifecycle": "node scripts/lifecycle.mjs",
    "seed": "node scripts/seed.mjs",
    "verify": "node scripts/verify.mjs",
    "fee-profile": "node scripts/fee-profile.mjs",
    "shots": "node scripts/shots.mjs",
    "diagram": "node scripts/diagram.mjs",
    "spike": "node scripts/spike-all.mjs",
    "baseline": "node scripts/baseline.mjs",
    "spike:cli": "node scripts/spike.mjs",
    "spike:e6": "node scripts/spike-e6.mjs",
    "probe:network": "node scripts/probe-network.mjs",
    "check:no-clock": "node scripts/check-no-clock.mjs",
    "test:v1:direct": "node scripts/run-python.mjs tests/v1/direct",
    "test:v1:integration": "node --test --test-concurrency=1 tests/v1/integration/payment-paths.test.mjs",
    "test:v1": "npm run test:v1:direct && npm run proof:v1 && npm run verify:offline",
    "proof:v1": "node scripts/proof-v1.mjs",
    "verify:offline": "node scripts/verify-offline.mjs",
    "deploy:v1": "node scripts/deploy-v1.mjs",
    "lifecycle:v1": "node scripts/lifecycle-v1.mjs",
    "probe:transfer": "node scripts/probe-transfer.mjs",
    "build:contracts": "node scripts/build-contracts.mjs",
    "test:v1:property": "node scripts/run-python.mjs tests/v1/direct/test_property_lifecycles.py",
    "counterfactual": "node scripts/counterfactual.mjs",
    "mutation": "node scripts/mutation.mjs",
    "books": "node scripts/books.mjs",
    "agent": "node examples/autonomous-agent.mjs",
    "parity": "vitest run tests/unit/parity.test.ts",
    "faults": "node scripts/faults.mjs",
    "gen:milestone-data": "node scripts/gen-milestone-data.mjs",
    "gen:docs": "node scripts/gen-docs.mjs"
  },
  "dependencies": {
    "@genlayer/transaction-kit": "0.1.0-rc.2",
    "@genlayer/transaction-kit-react": "0.1.0-rc.2",
    "framer-motion": "^12.0.0",
    "genlayer-js": "2.0.0-rc.1",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "viem": "^2.30.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  },
  "workspaces": [
    "packages/*"
  ]
}
