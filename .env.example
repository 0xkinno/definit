# ---------------------------------------------------------------------------
# DEFINIT -- environment template
# ---------------------------------------------------------------------------
#
# Copy this file to `.env.local` and fill it in. `.env.local` is gitignored and
# must never be committed.
#
# Until the three NEXT_PUBLIC_* address variables below contain real deployed
# addresses, DEFINIT runs in REHEARSAL: it walks the same state machine locally
# and labels every transition as a rehearsal. It will not pretend to be live.
#
# ---------------------------------------------------------------------------
# 1. Operator wallet  (server-side only -- never exposed to the browser)
# ---------------------------------------------------------------------------
#
# A funded GenLayer Studio Next account. It pays for contract deployment, demo
# actions, adjudication and finalisation. Test GEN only.
GENLAYER_PRIVATE_KEY=

# The operator-signed demo run is disabled unless this is exactly `true`.
# Leave it false to keep the write client dormant. Reads never need a key.
DEFINIT_ALLOW_SERVER_SIGNING=false

# ---------------------------------------------------------------------------
# 2. Network
# ---------------------------------------------------------------------------
GENLAYER_RPC_URL=https://studio-dev.genlayer.com/api

# Server-side aliases of the public values below, for the CLI scripts.
NEXT_PUBLIC_GENLAYER_CHAIN_ID=61997
NEXT_PUBLIC_GENLAYER_CHAIN_NAME=GenLayer Studio Next
NEXT_PUBLIC_GENLAYER_RPC_URL=https://studio-dev.genlayer.com/api
NEXT_PUBLIC_GENLAYER_EXPLORER_URL=https://explorer-studio-dev.genlayer.com

# ---------------------------------------------------------------------------
# 3. Deployed contract addresses
# ---------------------------------------------------------------------------
#
# `npm run deploy` prints these. Paste them here, restart the dev server, and
# the application switches from REHEARSAL to LIVE on its own.
NEXT_PUBLIC_DECISION_GATE_ADDRESS=
NEXT_PUBLIC_FINALITY_VAULT_ADDRESS=
NEXT_PUBLIC_SCENARIO_REGISTRY_ADDRESS=

# ---------------------------------------------------------------------------
# 3b. Public evidence snapshot
# ---------------------------------------------------------------------------
#
# Fetched by the decision contract from inside the GenVM, so it must be
# reachable over HTTPS from the network rather than from this machine.
DEFINIT_DEMO_EVIDENCE_URL=https://paste.rs/RaB2x

# ---------------------------------------------------------------------------
# 4. Browser wallet
# ---------------------------------------------------------------------------
#
# There is nothing to configure. Any EIP-1193 wallet works: the application
# detects it, offers the chain below with the standard add/switch pair, and
# routes every signing step through it. The user's key never reaches this
# application, and no key is ever needed for reading.
NEXT_PUBLIC_WALLET_ENABLED=true

# ---------------------------------------------------------------------------
# 5. Application
# ---------------------------------------------------------------------------
#
# Must be publicly reachable: the decision contract fetches the evidence
# snapshot over HTTPS, so a localhost value only works during local testing.
NEXT_PUBLIC_APP_URL=http://localhost:3000

